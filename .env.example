# Copy to .env for local development (never commit .env).
# Everything is optional locally — sensible defaults are used.

# Random string, 32+ chars. Signs session/invite token hashes. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public URL of the site (used for invite links and origin checks). REQUIRED in production.
# Local default: http://localhost:5173
APP_URL=

# PostgreSQL connection string. If empty, an embedded Postgres (PGlite) is stored in ./.data
# Example (Neon): postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/volunterrier?sslmode=require
DATABASE_URL=
# DATABASE_SSL=disable      # only for a local Postgres without TLS

# Load clearly-labelled sample listings on first run (true/false). Default: true
SEED_SAMPLE_DATA=true

# Geocoding for typed addresses outside the built-in Boston list: nominatim (OpenStreetMap, free) or off
GEOCODER=nominatim

# Only needed if the frontend is hosted on a DIFFERENT origin than the API (comma separated)
CORS_ORIGINS=

# Proxy hops in front of the app (Render: 1). Used so rate limits see real client IPs.
# TRUST_PROXY=1

# PORT=3001
# NODE_ENV=production

# ---- Optional PUBLIC build-time settings (these are bundled into the website; never put secrets here) ----
# Map tiles. Default is OpenStreetMap's community tile server, which is fine for demos but not for heavy traffic.
# For a commercial provider, use a browser key that is restricted to your domain in that provider's dashboard.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
